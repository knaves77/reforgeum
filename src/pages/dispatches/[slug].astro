---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import site from '../../data/site.json';
import { getDispatches, paperFor, issueNo, fmtDate, hrefFor } from '../../lib/board';
import { postSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const issues = await getDispatches();
  return [
    ...issues.map((entry, i) => ({
      params: { slug: entry.slug },
      props: { entry, prev: issues[i - 1], next: issues[i + 1] },
    })),
    // The old filename-based address forwards to the readable one.
    ...issues
      .filter((e) => e.post.id !== e.slug)
      .map((e) => ({ params: { slug: e.post.id }, props: { forward: hrefFor(e) } })),
  ];
}

if (Astro.props.forward) return Astro.redirect(Astro.props.forward, 301);
const { entry, prev, next } = Astro.props as Required<typeof Astro.props>;
const { post, issue, slug } = entry;
const { title, date, dek, stamp, cover, tags } = post.data;
const { Content } = await render(post);
const paper = paperFor(post);
---
<Base
  title={title}
  description={dek}
  image={`/og/dispatches/${slug}.jpg`}
  imageAlt={`${title}: a notice pinned to the ${site.title} board`}
  article={{ published: date, section: 'Dispatches', tags }}
  schema={postSchema(entry)}
  markdown={`/dispatches/${slug}.md`}
>
  <main class="board board-single">
    <Nav />

    <article class={`sheet paper-${paper.style}`} data-pagefind-body data-pagefind-meta="kind:Dispatch">
      <span class="pin pin-left" style={`--pin:${paper.pin}`} aria-hidden="true"></span>
      <span class="pin pin-right" style={`--pin:${paper.pin}`} aria-hidden="true"></span>

      <header>
        <p class="kicker" data-pagefind-ignore>
          <span><span class="kicker-site">{site.title} · </span>Dispatch {issueNo(issue)}</span>
          <time datetime={date.toISOString()} data-pagefind-meta="date">{fmtDate(date)}</time>
        </p>
        <h1 data-pagefind-meta="title">{title}</h1>
        {dek && <p class="dek">{dek}</p>}
        {stamp && <span class="stamp">{stamp}</span>}
      </header>

      {cover && <img class="cover" src={cover} alt="" fetchpriority="high" />}

      <div class="prose">
        <Content />
      </div>

      <footer class="sheet-footer" data-pagefind-ignore>
        <span>{site.author}</span>
        {tags.length > 0 && <span>filed under: {tags.join(', ')}</span>}
      </footer>
    </article>

    <nav class="neighbours" aria-label="More dispatches">
      {prev && <a class="neighbour earlier" href={hrefFor(prev)}><small>← Earlier</small>{prev.post.data.title}</a>}
      {next && <a class="neighbour later" href={hrefFor(next)}><small>Later →</small>{next.post.data.title}</a>}
    </nav>
  </main>
</Base>
