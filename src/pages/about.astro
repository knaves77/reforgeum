---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import site from '../data/site.json';
import Feeds from '../components/Feeds.astro';
import { graph, website, author, SITE_URL } from '../lib/seo';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
---
<Base
  title={about.data.title}
  description={about.data.dek}
  schema={graph(website, author, {
    '@type': 'AboutPage',
    url: `${SITE_URL}/about/`,
    name: about.data.title,
    isPartOf: { '@id': website['@id'] },
    mainEntity: { '@id': author['@id'] },
  })}
>
  <main class="board board-single">
    <Nav />
    <article class="sheet paper-newsprint">
      <span class="pin pin-left" style="--pin:#c8372d" aria-hidden="true"></span>
      <span class="pin pin-right" style="--pin:#e0b12a" aria-hidden="true"></span>
      <header>
        <p class="kicker"><span>{site.title}</span><span>About</span></p>
        <h1>{about.data.title}</h1>
        {about.data.dek && <p class="dek">{about.data.dek}</p>}
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="sheet-footer">
        <span>{site.author}</span>
        <Feeds />
      </footer>
    </article>
  </main>
</Base>
