---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base title="Torn down" noindex>
  <main class="board board-single">
    <Nav />
    <article class="sheet paper-kraft">
      <span class="pin pin-left" style="--pin:#c8372d" aria-hidden="true"></span>
      <h1>This notice has been torn down</h1>
      <p class="dek">Someone took it, or the rain did. Try the <a href="/archive/">archive</a>, or go back to <a href="/">the board</a>.</p>
    </article>
  </main>
</Base>
