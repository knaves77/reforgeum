---
import Base from '../layouts/Base.astro';
import Pamphlet from '../components/Pamphlet.astro';
import ScrapCard from '../components/ScrapCard.astro';
import Lights from '../components/Lights.astro';
import Nav from '../components/Nav.astro';
import Feeds from '../components/Feeds.astro';
import site from '../data/site.json';
import { getEverything } from '../lib/board';

// The board shows the latest notices; everything else lives in the archive.
const ON_BOARD = 18;
const all = (await getEverything()).reverse();
const recent = all.slice(0, ON_BOARD);

// The newest dispatch leads the board; scraps and older dispatches follow, newest first.
const lead = recent.find((e) => e.kind === 'dispatch');
const rest = recent.filter((e) => e !== lead);
---
<Base>
  <main class="board">
    <Lights />

    <header class="masthead">
      <p class="masthead-kicker">{site.tagline}</p>
      <h1>{site.title}</h1>
      <p class="masthead-sub">{site.subtitle}</p>
    </header>

    <Nav />

    <section class="pamphlets" aria-label="Latest notices">
      {lead && <Pamphlet post={lead.post} issue={lead.issue} featured />}
      <aside class="sticky-note" aria-label="Note">
        <span class="tape" aria-hidden="true" />
        {site.boardNote}
      </aside>
      {
        rest.map((e) =>
          e.kind === 'dispatch' ? <Pamphlet post={e.post} issue={e.issue} /> : <ScrapCard post={e.post} issue={e.issue} />,
        )
      }
    </section>

    {all.length === 0 && <p class="more">Nothing pinned up yet. The first notice is on its way.</p>}

    {
      all.length > ON_BOARD && (
        <p class="more">
          <a href="/archive/">{all.length - ON_BOARD} older notices are in the archive →</a>
        </p>
      )
    }

    <footer class="board-footer">
      <span>Pinned up by {site.author}</span>
      <Feeds />
    </footer>
  </main>
</Base>
